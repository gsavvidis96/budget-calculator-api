{
  "name": "budget-calculator-api",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "sst dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "dbmate up",
    "db:rollback": "dbmate down",
    "get-token": "tsx scripts/getTestToken.ts"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.9.0",
    "hono": "^4.12.32",
    "jose": "^6.2.4",
    "kysely": "^0.29.4",
    "pg": "^8.22.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@supabase/supabase-js": "^2.110.8",
    "@types/node": "^24.10.0",
    "@types/pg": "^8.20.0",
    "dbmate": "^2.34.1",
    "dotenv": "^17.4.2",
    "eslint": "^10.8.0",
    "prettier": "^3.9.6",
    "prettier-plugin-embed": "^0.5.1",
    "prettier-plugin-sql": "^0.20.0",
    "sst": "^4.17.1",
    "tsx": "^4.23.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.0.18"
  }
}
